# EcoGuard AI — environment configuration
# Copy to .env and fill in values. Never commit real secrets.

# --- Server ---
PORT=3001

# Force demo data for every provider when "true". Individual providers are
# live or unavailable per DATA_PROVIDER; they never silently fall back to
# demo on failure — turn this flag (or the in-app toggle) on to get fixtures.
DEMO_MODE=false

# Preferred environmental data provider: "demo" or "live".
# "live" uses keyless public endpoints where available. Weather/forecast use
# OpenWeather when a key is configured and surface "unavailable" on failure
# (they do not silently fall back to demo data in live mode). Air quality uses
# keyless Open-Meteo and also surfaces "unavailable" on failure — demo data
# appears only when DEMO_MODE is on or DATA_PROVIDER=demo. "demo" (default)
# never makes external data calls.
DATA_PROVIDER=demo

# --- OpenWeather (server-side only — never exposed to the browser) ---
# Required for live weather when DATA_PROVIDER=live. Get a key at
# https://openweathermap.org/api. Without it, live weather reports unavailable.
OPENWEATHER_API_KEY=

# --- Google Gemini (server-side only — never exposed to the browser) ---
# When empty, AI features (advisory phrasing, pollution interpretation,
# waste vision) use deterministic local fallbacks and are labeled as such.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
