# EcoGuard AI — environment configuration
# Copy to .env and fill in values. Never commit real secrets.

# --- Server ---
PORT=3001

# Force demo data for every provider when "true". Individual providers also
# fall back to demo automatically when they are not configured or fail.
DEMO_MODE=false

# Preferred environmental data provider: "demo" or "live".
# "live" uses keyless public endpoints where available and falls back to demo
# per-domain on failure. "demo" (default) never makes external data calls.
DATA_PROVIDER=demo

# --- Google Gemini (server-side only — never exposed to the browser) ---
# When empty, AI features (advisory phrasing, pollution interpretation,
# waste vision) use deterministic local fallbacks and are labeled as such.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
